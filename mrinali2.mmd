    %% ---------------------------------------------
    subgraph Phase_1 [Phase 1: Academic & Geographic Entry 2027 - 2029]
        Track_A1[BF TRACK:<br>MSQE Completion at ISI India<br>Timeline: 2027 - 2029]
        
        Track_B1[GF TRACK:<br>Employment in India<br>Timeline: 2027 - 2028]
        Track_B2[GF TRACK:<br>US MS Program Entry on F-1 Visa<br>Timeline: 2028 - 2030]
        
        Track_B1 --> Track_B2
    end

    %% ---------------------------------------------
    %% PHASE 2: PARALLEL US STATUS
    %% ---------------------------------------------
    subgraph Phase_2 [Phase 2: US Status Maintenance 2029 - 2033]
