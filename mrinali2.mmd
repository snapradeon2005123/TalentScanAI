    %% DECISION FORK (POST-LOTTERY 3)
    %% ---------------------------------------------
    Decision{Final Result After 3 Lottery Cycles}
    L1 -- Selected Year 1 --> H1B_App
    L2 -- Selected Year 2 --> H1B_App
    L3 -- Selected Year 3 --> Decision
    
    %% SCENARIO A: H-1B SELECTION
    subgraph Scenario_A [Scenario A: H-1B Selected]
        H1B_App[Change of Status to Independent H-1B Work Visa]
