        H1B_App --> Maintain_Ind
    end

    %% SCENARIO B: H-1B NON-SELECTION
    subgraph Scenario_B [Scenario B: H-1B Non-Selection]
        Action_Marry[Marry BF in 2033 for Status Safety Net]
        F2_Filing[File Form I-539 Change of Status: F-1 to F-2 Dependent]
        Work_Restriction[CRITICAL CONSTRAINT:<br>F-2 Visa Status Permits US Residency But Prohibits Work Authorization]
        
        Action_Marry --> F2_Filing
        F2_Filing --> Work_Restriction
    end

    Decision -- H-1B Selected --> H1B_App
    Decision -- H-1B Not Selected --> Action_Marry

    %% ---------------------------------------------
