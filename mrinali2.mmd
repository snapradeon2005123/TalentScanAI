    %% PHASE 3: ANNUAL LOTTERY REGISTRATIONS
    %% ---------------------------------------------
    subgraph Phase_3 [Phase 3: Annual H-1B Lottery Cycles]
        L1[2031 Lottery Registration:<br>Independent Attempt 1]
        L2[2032 Lottery Registration:<br>Independent Attempt 2]
        L3[2033 Lottery Registration:<br>Independent Attempt 3]
        
        L1 -- Not Selected --> L2
        L2 -- Not Selected --> L3
    end
    
